{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inmem-memo",
  "version": "1.2.1",
  "identifier": "com.inmemmemo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "inmem-memo",
        "width": 880,
        "height": 620,
        "minWidth": 520,
        "minHeight": 380,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "In-Memory Scratchpad Memo App",
    "longDescription": "Ultra-Fast In-Memory Scratchpad Memo Application for Windows & macOS"
  }
}
